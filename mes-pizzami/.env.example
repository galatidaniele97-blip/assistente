# Copiare in .env e adattare. Valori predefiniti = SQL Server in Docker (db/docker-compose.yml)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=MesPizzami
DB_USER=sa
DB_PASSWORD=Pizzami!Demo2026
